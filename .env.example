# ==============================================================================
# إعدادات البيئة لمركز القيادة الهولوغرامي
# My Road to be Trilunair Dr.MaJoOoOoOoD
# ==============================================================================

# وضع التداول الافتراضي الآمن — يجب أن يظل PAPER ما لم يصرح المسؤول رسمياً عبر البوابة
TRILUNAIR_DEFAULT_MODE=PAPER

# رمز التصريح الإداري لبوابة تفعيل التداول الحقيقي (لأغراض الاختبار المحلي: 7777)
TRILUNAIR_ADMIN_PIN=7777

# مسار قاعدة البيانات المستديمة SQLite
TRILUNAIR_DB_PATH=./data/trilunair.db

# منفذ الخادم الخلفي
PORT=8000

# مفاتيح مزودي الذكاء الاصطناعي والصوت الاختيارية (يعمل النظام محلياً بالكامل بدونها،
# ويترقى تلقائياً لاستخدام النماذج السحابية فور تزويدها)
OPENAI_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
