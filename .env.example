# ==============================================================================
# قالب متغيرات البيئة لمركز القيادة الكمي
# My Road to be Trilunair Dr.MaJoOoOoOoD
# ==============================================================================

# الوضع الافتراضي الإلزامي (لا تغيره إلى LIVE مطلقاً في الإقلاع التلقائي)
TRILUNAIR_DEFAULT_MODE=PAPER
TRILUNAIR_ADMIN_PIN=7777

# قواعد البيانات والتخزين المستديم (PostgreSQL + Redis + مسار احتياطي SQLite)
DATABASE_URL=postgresql://trilunair:trilunair_quantum_pw@localhost:5432/trilunair
REDIS_URL=redis://localhost:6379/0
TRILUNAIR_DB_PATH=./backend/data/trilunair.db

# ضوابط الصلاحية الزمنية وحداثة الأسعار
TRILUNAIR_PROPOSAL_TTL_SECONDS=180
TRILUNAIR_MARKET_STALE_SECONDS=15

# مفاتيح مزودات النماذج اللغوية (اختيارية — عند تركها فارغة تُعلّم كـ UNAVAILABLE بصدق)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# إعدادات محول Binance Spot (اختيارية — للتجارب الآمنة استخدم Testnet فقط)
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_SPOT_BASE_URL=https://testnet.binance.vision
