# ==============================================================================
# قالب متغيرات البيئة الآمن — الإصدار v1.1.0-cloud-paper
# My Road to be Trilunair Dr.MaJoOoOoOoD — QUANTUM AI TRADING COMMAND CENTER
# ملاحظة أمنية: يحتوي هذا الملف على عناصر نائبة (Placeholders) فقط دون أي أسرار حقيقية.
# لا تلتزم بملف .env الفعلي في Git مطلقاً.
# ==============================================================================

# 1. بيئة التشغيل والقفل الدائم للتداول الورقي (إلزامي: لا يُسمح بتفعيل LIVE في هذا الإصدار)
TRILUNAIR_ENV=production
TRILUNAIR_DEFAULT_MODE=PAPER
TRILUNAIR_COOKIE_SECURE=true
TRILUNAIR_ALLOWED_ORIGINS=https://your-domain.example.com,http://localhost:8000

# 2. مصادقة المسؤول المشفرة (Fail-Closed — لا توجد أي قيم افتراضية أو رموز رقمية ضعيفة)
# لتوليد تجزئة PBKDF2-HMAC-SHA256 نفذ:
# python3 -c "from app.security import hash_admin_secret; print(hash_admin_secret('YOUR_STRONG_SECRET'))"
TRILUNAIR_ADMIN_SECRET_HASH=<REPLACE_WITH_PBKDF2_SHA256_ADMIN_SECRET_HASH>
TRILUNAIR_SESSION_SECRET=<REPLACE_WITH_64_HEX_RANDOM_SESSION_SIGNING_SECRET>
TRILUNAIR_SESSION_TTL_SECONDS=3600
TRILUNAIR_AUTH_MAX_ATTEMPTS=5
TRILUNAIR_AUTH_LOCKOUT_SECONDS=300
TRILUNAIR_API_RATE_LIMIT_PER_MIN=600

# 3. قواعد البيانات والتخزين المستديم (PostgreSQL 16 + Redis 7)
POSTGRES_USER=trilunair
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>
POSTGRES_DB=trilunair
DATABASE_URL=postgresql://trilunair:<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>@postgres:5432/trilunair
REDIS_URL=redis://redis:6379/0
TRILUNAIR_DB_PATH=/app/backend/data/trilunair.db

# 4. بيانات السوق العامة الحية لـ Binance Spot (قراءة عامة فقط + تنفيذ ورقي محاكي 100%)
# القيم المتاحة: LIVE_PUBLIC (بيانات عامة حية من Binance Spot) أو SIMULATED (محرك محلي حتمي)
TRILUNAIR_MARKET_DATA_MODE=LIVE_PUBLIC
BINANCE_SPOT_PUBLIC_REST_URL=https://data-api.binance.vision
BINANCE_SPOT_PUBLIC_WS_URL=wss://data-stream.binance.vision/stream
TRILUNAIR_PROPOSAL_TTL_SECONDS=180
TRILUNAIR_MARKET_STALE_SECONDS=15

# 5. نطاق البوابة العكسية السحابية (Caddy Automatic HTTPS + WSS)
TRILUNAIR_CLOUD_DOMAIN=trilunair.example.com
TRILUNAIR_TLS_EMAIL=admin@example.com

# 6. مزودات الذكاء الاصطناعي الاختيارية (عند تركها فارغة تعمل المحاكاة الكمية المحلية بشفافية معلنة)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
XAI_MODEL=grok-3-mini
TRILUNAIR_LLM_TIMEOUT_SEC=12
TRILUNAIR_LLM_MAX_RETRIES=2
TRILUNAIR_LLM_CACHE_TTL_SEC=30

# 7. مفاتيح Binance المصادقة غير مطلوبة وغير مستخدمة لتنفيذ الأوامر في الإصدار v1.1.0-cloud-paper
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_SPOT_BASE_URL=https://testnet.binance.vision
