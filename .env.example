# ==============================================================================
# قالب متغيرات البيئة الآمن — الإصدار v1.2.0-low-latency-cloudflare
# My Road to be Trilunair Dr.MaJoOoOoOoD — QUANTUM AI TRADING COMMAND CENTER
# النطاق المستقل المعتمد: https://trilunair.medinsup.com
# ضمان العزل الطبي الحرج: معزول 100% عن medinsup.com وخوادم الرياض الطبية.
# ملاحظة أمنية: يحتوي هذا الملف على عناصر نائبة (Placeholders) فقط دون أي أسرار حقيقية.
# لا تلتزم بملف .env الفعلي في Git مطلقاً.
# ==============================================================================

# 1. بيئة التشغيل، العزل التام للنطاق الفرعي، والقفل الدائم للتداول الورقي (PAPER)
TRILUNAIR_ENV=production
TRILUNAIR_DEFAULT_MODE=PAPER
TRILUNAIR_PRIMARY_DOMAIN=trilunair.medinsup.com
TRILUNAIR_COOKIE_SECURE=true
# يُحظر إدراج medinsup.com أو *.medinsup.com حفاظاً على العزل التام للمنصة الطبية
TRILUNAIR_ALLOWED_ORIGINS=https://trilunair.medinsup.com

# 2. بوابة Cloudflare Zero Trust Access الخارجية للمالك الوحيد (اختياري/موصى به في الإنتاج)
TRILUNAIR_REQUIRE_CF_ACCESS=false
CF_ACCESS_TEAM_DOMAIN=<REPLACE_WITH_TEAM_NAME>.cloudflareaccess.com
CF_ACCESS_AUD=<REPLACE_WITH_CLOUDFLARE_ACCESS_APPLICATION_AUD_TAG>
CF_ACCESS_OWNER_EMAIL=<REPLACE_WITH_OWNER_EMAIL>
CF_ACCESS_PUBLIC_KEY_PEM=

# 3. المصادقة البيومترية للمالك (WebAuthn / FIDO2 Passkeys: Face ID / Touch ID / Security Key)
TRILUNAIR_WEBAUTHN_RP_ID=trilunair.medinsup.com
TRILUNAIR_WEBAUTHN_RP_NAME=TRILUNAIR Quantum Command Center
TRILUNAIR_WEBAUTHN_ORIGINS=https://trilunair.medinsup.com
TRILUNAIR_WEBAUTHN_CHALLENGE_TTL_SEC=300
TRILUNAIR_STEP_UP_TTL_SEC=180
TRILUNAIR_REQUIRE_PASSKEY_STEP_UP=false

# 4. مصادقة المسؤول المشفرة الاحتياطية (Fail-Closed — لا توجد أي رموز رقمية افتراضية ضعيفة)
# لتوليد تجزئة PBKDF2-HMAC-SHA256 نفذ:
# python3 -c "from app.security import hash_admin_secret; print(hash_admin_secret('YOUR_STRONG_SECRET'))"
TRILUNAIR_ADMIN_SECRET_HASH=<REPLACE_WITH_PBKDF2_SHA256_ADMIN_SECRET_HASH>
TRILUNAIR_SESSION_SECRET=<REPLACE_WITH_64_HEX_RANDOM_SESSION_SIGNING_SECRET>
TRILUNAIR_SESSION_TTL_SECONDS=3600
TRILUNAIR_AUTH_MAX_ATTEMPTS=5
TRILUNAIR_AUTH_LOCKOUT_SECONDS=300
TRILUNAIR_API_RATE_LIMIT_PER_MIN=600

# 5. قاعدة البيانات المستديمة الأصلية بدون Docker (PostgreSQL 16 على 127.0.0.1:5432 فقط)
POSTGRES_USER=trilunair_app
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>
POSTGRES_DB=trilunair
DATABASE_URL=postgresql://trilunair_app:<REPLACE_WITH_STRONG_POSTGRES_PASSWORD>@127.0.0.1:5432/trilunair
REDIS_URL=redis://127.0.0.1:6379/0
TRILUNAIR_DB_PATH=/var/lib/trilunair/trilunair.db
TRILUNAIR_HOSTING_MONTHLY_USD=12.0

# 6. بيانات السوق العامة الحية منخفضة الكمون لـ Binance Spot (قراءة عامة فقط + تنفيذ PAPER 100%)
TRILUNAIR_MARKET_DATA_MODE=LIVE_PUBLIC
BINANCE_SPOT_PUBLIC_REST_URL=https://data-api.binance.vision
BINANCE_SPOT_PUBLIC_WS_URL=wss://data-stream.binance.vision/stream
TRILUNAIR_PROPOSAL_TTL_SECONDS=180
TRILUNAIR_MARKET_STALE_SECONDS=15

# 7. مجلس الوكلاء المتوازي منخفض الكمون والواعي بالتكلفة (Bounded-Deadline Parallel AI Council)
TRILUNAIR_COUNCIL_DEADLINE_MS=6500
TRILUNAIR_SIGNAL_TTL_SEC=90
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
XAI_API_KEY=
XAI_MODEL=grok-3-mini
TRILUNAIR_LLM_TIMEOUT_SEC=6
TRILUNAIR_LLM_MAX_RETRIES=1
TRILUNAIR_LLM_CACHE_TTL_SEC=30

# 8. مفاتيح Binance المصادقة غير مستخدمة لتنفيذ الأوامر (التنفيذ مقفل نهائياً على PAPER)
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_SPOT_BASE_URL=https://testnet.binance.vision
