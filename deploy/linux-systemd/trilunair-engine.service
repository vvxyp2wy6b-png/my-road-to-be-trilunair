[Unit]
Description=TRILUNAIR Quantum AI Trading Engine (FastAPI + Uvicorn, Docker-Free Native)
Documentation=https://trilunair.medinsup.com
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=trilunair
Group=trilunair
WorkingDirectory=/opt/trilunair/app/backend
EnvironmentFile=/etc/trilunair/trilunair.env
ExecStart=/opt/trilunair/app/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=20

# Strict Linux systemd sandboxing (Zero root privileges, loopback-only bind)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/trilunair /var/log/trilunair
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
